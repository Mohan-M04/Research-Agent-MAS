# ─────────────────────────────────────────────────────────────────────────────
# Research Companion — Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# watsonx.ai / watsonx Orchestrate credentials
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_SPACE_ID=your_deployment_space_id_here

# IBM Cloud region (us-south | eu-de | jp-tok | au-syd)
IBM_CLOUD_REGION=us-south

# Foundation model IDs (use models available in your region)
# Reasoning / QA model
WX_MODEL_QA=ibm/granite-3-3-8b-instruct
# Literature review / summarization model
WX_MODEL_SUMMARIZE=ibm/granite-3-3-8b-instruct
# Embedding model
WX_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr

# Knowledge base storage path (local vector store directory)
KB_PERSIST_DIRECTORY=./knowledge_base/chroma_db

# Chunking parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_CHUNKS=8

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
